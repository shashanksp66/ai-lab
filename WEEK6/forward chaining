# First Order Logic - Forward Chaining

# Initial Knowledge Base
KB = [
    "American(Robert)",
    "Missile(T1)",
    "Owns(A,T1)",
    "Enemy(A,America)"
]

print("Initial Knowledge Base:")
for fact in KB:
    print(fact)

# Forward Chaining
new_fact = True

while new_fact:
    new_fact = False

    # Rule 1: Missile(x) -> Weapon(x)
    if "Missile(T1)" in KB and "Weapon(T1)" not in KB:
        KB.append("Weapon(T1)")
        print("Inferred: Weapon(T1)")
        new_fact = True

    # Rule 2: Missile(x) AND Owns(A,x) -> Sells(Robert,x,A)
    if ("Missile(T1)" in KB and "Owns(A,T1)" in KB
            and "Sells(Robert,T1,A)" not in KB):
        KB.append("Sells(Robert,T1,A)")
        print("Inferred: Sells(Robert,T1,A)")
        new_fact = True

    # Rule 3: Enemy(x,America) -> Hostile(x)
    if ("Enemy(A,America)" in KB and "Hostile(A)" not in KB):
        KB.append("Hostile(A)")
        print("Inferred: Hostile(A)")
        new_fact = True

    # Rule 4: American(p) AND Weapon(q)
    # AND Sells(p,q,r) AND Hostile(r) -> Criminal(p)
    if ("American(Robert)" in KB
            and "Weapon(T1)" in KB
            and "Sells(Robert,T1,A)" in KB
            and "Hostile(A)" in KB
            and "Criminal(Robert)" not in KB):

        KB.append("Criminal(Robert)")
        print("Inferred: Criminal(Robert)")
        new_fact = True

# Display result
print("\nFinal Knowledge Base:")
for fact in KB:
    print(fact)

if "Criminal(Robert)" in KB:
    print("\nGoal Proved: Robert is Criminal")
else:
    print("\nGoal Not Proved")

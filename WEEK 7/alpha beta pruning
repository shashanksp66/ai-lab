def alphabeta(node, depth, alpha, beta, maximizing):

    if depth == 0:
        return node

    if maximizing:
        best = float('-inf')

        for child in node:
            value = alphabeta(child, depth - 1,
                              alpha, beta, False)

            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = float('inf')

        for child in node:
            value = alphabeta(child, depth - 1,
                              alpha, beta, True)

            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                break

        return best



tree = [
    [3, 5],
    [6, 9],
    [1, 2],
    [0, -1]
]

result = alphabeta(tree, 2, float('-inf'),
                   float('inf'), True)

print("Optimal Value:", result)
